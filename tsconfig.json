{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "declaration": true,
    "removeComments": true,

    "sourceMap": true,
    "outDir": "./dist",

    "skipLibCheck": true
  }
}
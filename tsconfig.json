{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",

    "moduleResolution": "node",

    "types": ["node", "express"],

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "declaration": true,
    "removeComments": true,

    "sourceMap": true,
    "outDir": "./dist",

    "skipLibCheck": true
  }
}
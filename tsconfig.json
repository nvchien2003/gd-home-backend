{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",

    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"]
    },

    "moduleResolution": "node",

    "incremental": true,
    "skipLibCheck": true
  }
}